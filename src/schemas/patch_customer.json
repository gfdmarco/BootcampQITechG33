{
    "title": "PatchCustomer",
    "type": "object",
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
        },
        "email": {
            "type": "string",
            "maxLength": 255,
            "pattern": "^[^\\s]+@[^\\s]+\\.[^\\s]+$"
        }
    },
    "anyOf": [
        { "required": ["name"] },
        { "required": ["email"] }
    ],
    "additionalProperties": false
}
