{
  "title": "GetAccounts",
  "type": "object",
  "properties": {
    "limit": {
      "type": "string",
      "pattern": "^(100|[1-9]?[0-9])$"
    },
    "page": {
      "type": "string",
      "pattern": "^[0-9]{1,9}$"
    },
    "status": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["created", "active", "blocked", "closed"]
      }
    },
    "branch": {
      "type": "string",
      "pattern": "^\\d{4}$"
    },
    "number": {
      "type": "string",
      "pattern": "^\\d{1,10}$"
    },
    "account_type": {
      "type": "string",
      "enum": ["checking", "savings"]
    },
    "balance_from": {
      "type": "string",
      "pattern": "^[0-9]{1,15}$"
    },
    "date_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "date_to": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "additionalProperties": false
}