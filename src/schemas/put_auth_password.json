{
    "title": "PutAuthPassword",
    "type": "object",
    "properties": {
        "current_password": {
            "type": "string",
            "minLength": 1
        },
        "new_password": {
            "type": "string",
            "pattern": "^(?=.*[A-Za-z])(?=.*\\d)[A-Za-z\\d@$!%*#?&]{8,}$"
        }
    },
    "required": [
        "current_password",
        "new_password"
    ],
    "additionalProperties": false
}
