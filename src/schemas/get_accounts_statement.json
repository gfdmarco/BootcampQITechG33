{
  "title": "GetAccountsStatement",
  "type": "object",
  "properties": {
    "account_key": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36
    },
    "limit": {
      "type": "string",
      "pattern": "^(100|[1-9]?[0-9])$"
    },
    "page": {
      "type": "string",
      "pattern": "^[0-9]{1,9}$"
    },
    "date_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "date_to": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "required": ["account_key"],
  "additionalProperties": false
}