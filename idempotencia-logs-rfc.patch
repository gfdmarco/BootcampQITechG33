+git clone https://github.com/gfdmarco/BootcampQITechG33.git
+cd BootcampQITechG33
+cp .env.example .env
+# no .env, troque BANKSLIP_API_URL=http://localhost:8080 por
+#   BANKSLIP_API_URL=http://bankslip-mock:8080   (o endereço do mock DENTRO do compose)
